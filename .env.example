# ---- App (Expo) ----------------------------------------------------------
# Public values, safe to ship in the client bundle. From your Supabase project
# settings → API. The project MUST be created in the Sydney (ap-southeast-2) region.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# EAS build project id (from `eas init`)
EAS_PROJECT_ID=

# ---- Supabase Edge Functions (SERVER-SIDE SECRETS) -----------------------
# These are NEVER shipped to the device. Set them with:
#   supabase secrets set TOGETHER_API_KEY=... ANTHROPIC_API_KEY=...
# Listed here only for documentation.
# TOGETHER_API_KEY=...             # NVIDIA Parakeet transcription (Together AI)
# ANTHROPIC_API_KEY=sk-ant-...     # Claude insights + recommendations
# PARAKEET_MODEL=nvidia/parakeet-tdt-0.6b-v3   # optional override
# PARAKEET_API_URL=https://api.together.xyz/v1/audio/transcriptions  # optional override
# SUPABASE_SERVICE_ROLE_KEY=...    # auto-injected into functions by Supabase

# RevenueCat public SDK keys (Individual plan purchases)
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=
